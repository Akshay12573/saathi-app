# Copy this file to .env and fill in real values. Never commit the real .env.

# Required — the only place the LLM provider key lives.
OPENAI_API_KEY=sk-...

# Which model to use for chat/intent-classification.
OPENAI_MODEL=gpt-4o-mini

# Shared secret the Android app sends as the "x-saathi-key" header.
# This is NOT the OpenAI key — it only authenticates app installs to this
# backend. Rotate it independently of the LLM key.
SAATHI_BACKEND_API_KEY=change-me-to-a-long-random-string

# Optional — enables the AI web research endpoint (#17). Get a free key at
# https://tavily.com. If unset, /api/research returns a clear "not configured"
# response instead of silently failing.
TAVILY_API_KEY=

PORT=8080
