<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: no cleartext anywhere — required once SAATHI_BACKEND_BASE_URL
         is an https:// URL (see README "Running the backend"). -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Local-dev-only stopgap: if you're pointing the app at a plain-HTTP
         backend while HTTPS isn't wired up yet, add your backend's own
         host/IP here on your machine. Do NOT commit a real IP/domain here —
         keep this file generic in the shared repo and edit it locally only
         for your own test builds. -->
    <!--
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">YOUR_BACKEND_HOST_OR_IP</domain>
    </domain-config>
    -->
</network-security-config>
